---
import { SITE } from "../config/site.ts";
interface Props { href?: string }
const { href = "/" } = Astro.props;
---
<a class="brand" href={href} aria-label={`${SITE.name} home`}>
  <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
    <rect width="40" height="40" rx="10" fill="#16b379"/>
    <path d="M9 13.5c4-1.6 7.6-1.2 11 1.3 3.4-2.5 7-2.9 11-1.3v14c-4-1.6-7.6-1.2-11 1.3-3.4-2.5-7-2.9-11-1.3z" fill="#fff"/>
    <path d="M20 14.8v14" stroke="#16b379" stroke-width="1.6"/>
    <circle cx="30" cy="10" r="4" fill="#ffd98c"/>
  </svg>
  <span>Michigan School <b>Jobs</b></span>
</a>
