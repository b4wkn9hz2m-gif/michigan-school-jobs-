---
import "../styles.css";
import { SITE } from "../config/site.ts";
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
interface Props { title?: string; description?: string; noindex?: boolean; jsonLd?: object }
const { title, description = SITE.description, noindex = false, jsonLd } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | Michigan schools and great people find each other`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const seekers = [
  { href: "/jobs", label: "Find Jobs" },
  { href: "/jobs?saved=1", label: "Saved Jobs", saved: true },
  { href: "/counties", label: "Jobs by County" },
  { href: "/categories/teaching", label: "Teaching Jobs" },
  { href: "/about", label: "About Us" },
];
const employers = [
  { href: "/post-a-job", label: "Post a Job" },
  { href: "/pricing", label: "Plans & Pricing" },
  { href: "/contact", label: "Contact" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b2145" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="bar">
        <div style="flex:1"><Logo /></div>
        <nav class="main" aria-label="Main">
          <details class="menu"><summary>Job Seekers<span class="badge-count" data-saved-count hidden></span></summary><div class="drop">{seekers.map((l) => <a href={l.href}>{l.label}{"saved" in l && <span class="badge-count" data-saved-count hidden></span>}</a>)}</div></details>
          <details class="menu"><summary>Employers</summary><div class="drop">{employers.map((l) => <a href={l.href}>{l.label}</a>)}</div></details>
        </nav>
        <div class="cta">
          <a class="btn-outline-light" href="/post-a-job">Post a Job</a>
        </div>
        <details class="mobile-menu">
          <summary aria-label="Menu"><Icon name="menu" class="" /></summary>
          <div class="drop">{[...seekers, ...employers].map((l) => <a href={l.href}>{l.label}{"saved" in l && <span class="badge-count" data-saved-count hidden></span>}</a>)}</div>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site">
      <div class="top">
        <div class="cols">
          <div>
            <Logo />
            <p class="about">Every Michigan school job in one friendly place, updated every morning. Always free for job seekers.</p>
          </div>
          <div><h3>Job Seekers</h3><ul><li><a href="/jobs">Search Jobs</a></li><li><a href="/counties">Jobs by County</a></li><li><a href="/about">How it works</a></li></ul></div>
          <div><h3>Employers</h3><ul><li><a href="/pricing">Plans and Pricing</a></li><li><a href="/post-a-job">Post a Job</a></li></ul></div>
          <div><h3>Contact Us</h3><ul><li><a href="/about">About Us</a></li><li><a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></li></ul></div>
        </div>
      </div>
      <div class="bottom">© {new Date().getFullYear()} {SITE.name} · Listings link to each employer's official application · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/sitemap.xml">Sitemap</a></div>
    </footer>
    <script>
      // ----- Saved jobs (kept on this device only) -----
      const KEY = "msj-saved-jobs";
      const readSaved = (): string[] => { try { return JSON.parse(localStorage.getItem(KEY) || "[]"); } catch { return []; } };
      const writeSaved = (list: string[]) => { try { localStorage.setItem(KEY, JSON.stringify(list)); } catch {} };
      function toast(msg: string) {
        document.querySelector(".toast")?.remove();
        const t = Object.assign(document.createElement("div"), { className: "toast", textContent: msg });
        t.setAttribute("role", "status");
        document.body.append(t); setTimeout(() => t.remove(), 2200);
      }
      function syncSaved() {
        const saved = new Set(readSaved());
        document.querySelectorAll<HTMLElement>("[data-save]").forEach((b) => {
          const on = saved.has(b.dataset.save!);
          b.setAttribute("aria-pressed", String(on));
          const label = b.querySelector("[data-save-label]");
          if (label) label.textContent = on ? "Saved" : "Save job";
        });
        document.querySelectorAll<HTMLElement>("[data-saved-count]").forEach((el) => { el.textContent = String(saved.size); el.hidden = saved.size === 0; });
      }
      document.addEventListener("click", (e) => {
        const btn = (e.target as Element).closest<HTMLElement>("[data-save]");
        if (!btn) return;
        e.preventDefault();
        const list = readSaved(); const slug = btn.dataset.save!;
        const i = list.indexOf(slug);
        if (i >= 0) { list.splice(i, 1); toast("Removed from saved jobs"); } else { list.unshift(slug); toast("Saved. Find it under Job Seekers → Saved Jobs"); }
        writeSaved(list); syncSaved();
        document.dispatchEvent(new CustomEvent("saved-changed"));
      });
      (window as any).msjSyncSaved = syncSaved;
      (window as any).msjReadSaved = readSaved;
      (window as any).msjToast = toast;

      // ----- Friendly dates: "Today", "Yesterday", "3 days ago" -----
      function relDates(root: ParentNode = document) {
        const today = new Date(); today.setHours(0, 0, 0, 0);
        root.querySelectorAll<HTMLTimeElement>("time[data-rel]").forEach((t) => {
          const d = new Date(t.dateTime); d.setHours(0, 0, 0, 0);
          const days = Math.round((today.getTime() - d.getTime()) / 86_400_000);
          if (days <= 0) t.textContent = "Today";
          else if (days === 1) t.textContent = "Yesterday";
          else if (days < 14) t.textContent = `${days} days ago`;
          else if (days >= 365) t.textContent = "Over a year ago";
          t.title = d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
        });
      }
      (window as any).msjRelDates = relDates;
      relDates(); syncSaved();

      // Close the other dropdown when one opens, and close on outside click.
      const menus = [...document.querySelectorAll<HTMLDetailsElement>("details.menu, details.mobile-menu")];
      menus.forEach((m) => m.addEventListener("toggle", () => { if (m.open) menus.forEach((o) => o !== m && (o.open = false)); }));
      document.addEventListener("click", (e) => menus.forEach((m) => { if (!m.contains(e.target as Node)) m.open = false; }));
    </script>
  </body>
</html>
