---
import Base from "../../layouts/Base.astro";
import JobCard from "../../components/JobCard.astro";
import { COUNTIES } from "../../config/taxonomy.ts";
import { jobs, allCategories, countByCategory, countySlug, COMBO_MIN_JOBS } from "../../lib/jobs.ts";
export function getStaticPaths() {
  return COUNTIES.filter((c) => jobs.some((j) => j.county === c)).map((county) => ({ params: { county: countySlug(county) }, props: { county } }));
}
const { county } = Astro.props as { county: string };
const list = jobs.filter((j) => j.county === county);
const cats = countByCategory(list);
---
<Base title={`School jobs in ${county} County, MI`} description={`${list.length} open school jobs in ${county} County, Michigan: teaching, special education, support staff and more.`} noindex={list.length === 0}>
  <section class="page-hero"><div>
    <div class="crumbs"><a href="/counties">Counties</a> › {county}</div>
    <h1>{county} County</h1><p>{list.length} open school {list.length === 1 ? "job" : "jobs"} · updated every morning</p>
  </div></section>
  <div class="page"><div class="wrap">
    {list.length > 0 && (
      <div class="chips">
        {allCategories.filter((c) => (cats.get(c.slug) ?? 0) > 0).map((c) => (
          <a class="chip" href={(cats.get(c.slug) ?? 0) >= COMBO_MIN_JOBS ? `/counties/${countySlug(county)}/${c.slug}` : `/jobs?county=${encodeURIComponent(county)}&category=${c.slug}`}>{c.name} ({cats.get(c.slug)})</a>
        ))}
      </div>
    )}
    {list.length > 0 ? <div class="results">{list.map((job) => <JobCard job={job} />)}</div>
      : <div class="panel empty">No open listings in {county} County right now. <a href="/jobs">Search all of Michigan</a>.</div>}
  </div></div>
</Base>
