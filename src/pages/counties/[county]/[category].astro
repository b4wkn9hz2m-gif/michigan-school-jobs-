---
// Landing pages for searches like "special education jobs Oakland County Michigan".
// Only built where there are enough jobs to be useful (thin pages hurt search rankings).
import Base from "../../../layouts/Base.astro";
import JobCard from "../../../components/JobCard.astro";
import { SITE } from "../../../config/site.ts";
import { jobs, allCategories, countySlug, comboPages, type Job } from "../../../lib/jobs.ts";

export function getStaticPaths() {
  return comboPages().map(({ county, category, list }) => ({
    params: { county: countySlug(county), category: category.slug },
    props: { county, category, list },
  }));
}
const { county, category, list } = Astro.props as { county: string; category: { slug: string; name: string }; list: Job[] };
const SITE_URL = `https://${SITE.domain}`;
const employers = [...new Set(list.map((j) => j.employer))];
const paid = list.filter((j) => j.salary);
const others = allCategories.filter((c) => c.slug !== category.slug && jobs.some((j) => j.county === county && j.category === c.slug));
const title = `${category.name} Jobs in ${county} County, MI`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Counties", item: new URL("/counties", SITE_URL).href },
    { "@type": "ListItem", position: 2, name: `${county} County`, item: new URL(`/counties/${countySlug(county)}`, SITE_URL).href },
    { "@type": "ListItem", position: 3, name: category.name, item: new URL(`/counties/${countySlug(county)}/${category.slug}`, SITE_URL).href },
  ],
};
---
<Base title={title} description={`${list.length} open ${category.name.toLowerCase()} jobs at ${employers.length} school ${employers.length === 1 ? "employer" : "employers"} in ${county} County, Michigan. Updated daily; apply directly with each district.`} jsonLd={jsonLd}>
  <section class="page-hero"><div>
    <div class="crumbs"><a href="/counties">Counties</a> › <a href={`/counties/${countySlug(county)}`}>{county}</a> › {category.name}</div>
    <h1>{category.name} jobs in {county} County</h1>
    <p>{list.length} open {list.length === 1 ? "job" : "jobs"} · {employers.length} {employers.length === 1 ? "employer" : "employers"} · updated every morning</p>
  </div></section>
  <div class="page"><div class="wrap">
    <p style="color:var(--muted);max-width:820px;margin:0 0 20px">
      Open {category.name.toLowerCase()} positions at {county} County schools{employers.length > 1 ? `, including ${employers.slice(0, 3).join(", ")}` : `, at ${employers[0]}`}.
      {paid.length > 0 && ` ${paid.length} of these list their pay.`} Every listing links to the employer's official application.
    </p>
    <div class="results">{list.map((job) => <JobCard job={job} />)}</div>
    {others.length > 0 && (
      <div style="margin-top:36px">
        <h2 style="font-size:20px;font-weight:500">More school jobs in {county} County</h2>
        <div class="chips">{others.map((c) => <a class="chip" href={`/jobs?county=${encodeURIComponent(county)}&category=${c.slug}`}>{c.name}</a>)}</div>
      </div>
    )}
  </div></div>
</Base>
