---
import Base from "../../layouts/Base.astro";
import { countByCounty, countySlug } from "../../lib/jobs.ts";
const counts = [...countByCounty().entries()].filter(([, n]) => n > 0).sort((a, b) => b[1] - a[1]);
---
<Base title="School jobs by Michigan county" description="Browse Michigan school jobs by county.">
  <section class="page-hero"><div><h1>Jobs by County</h1><p>Counties with open school jobs right now. More are added as we connect more districts.</p></div></section>
  <div class="page"><div class="wrap">
    <div class="grid">
      {counts.map(([c, n]) => <a class="tile" href={`/counties/${countySlug(c)}`}><span>{c} County</span><small>{n} {n === 1 ? "job" : "jobs"}</small></a>)}
    </div>
  </div></div>
</Base>
