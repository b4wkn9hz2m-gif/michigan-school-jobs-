---
import Base from "../../layouts/Base.astro";
import JobCard from "../../components/JobCard.astro";
import { COUNTIES, JOB_TYPES } from "../../config/taxonomy.ts";
import { jobs, allCategories, formatDate } from "../../lib/jobs.ts";
// Only the fields the client-side filter needs, to keep the page light.
const index = jobs.map((j) => ({
  s: j.slug, t: j.title, e: j.employer, c: j.county, ci: j.city, ty: j.type, ca: j.category,
  p: formatDate(j.postedAt), f: j.featured ? 1 : 0, x: j.excerpt.slice(0, 160).toLowerCase(),
}));
const catNames = Object.fromEntries(allCategories.map((c) => [c.slug, c.name]));
const INITIAL = 40;
---
<Base title="Search Michigan school jobs" description="Filter every Michigan school job by county, category and job type.">
  <section class="page-hero"><div><h1>Positions</h1><p>Every open job from Michigan schools, updated every morning.</p></div></section>
  <div class="page">
    <div class="wrap layout-search">
      <div>
        <p class="result-count" id="count" aria-live="polite">{jobs.length.toLocaleString()} open jobs</p>
        <div class="results" id="results">
          {jobs.slice(0, INITIAL).map((job) => <JobCard job={job} />)}
        </div>
        {jobs.length === 0 && <div class="panel empty">No jobs listed yet. Check back tomorrow morning.</div>}
        <p style="text-align:center;margin-top:28px"><button class="btn btn-green" id="more" type="button" hidden>Show more jobs</button></p>
      </div>
      <form class="filters" id="filters" role="search" aria-label="Filter jobs">
        <h2>Search jobs</h2>
        <label>Keyword<input name="q" type="search" placeholder="Title, district, keyword" /></label>
        <label>County
          <select name="county"><option value="">All counties</option>{COUNTIES.map((c) => <option value={c}>{c}</option>)}</select>
        </label>
        <label>Category
          <select name="category"><option value="">All categories</option>{allCategories.map((c) => <option value={c.slug}>{c.name}</option>)}</select>
        </label>
        <label>Job type
          <select name="type"><option value="">All types</option>{JOB_TYPES.map((t) => <option value={t}>{t}</option>)}</select>
        </label>
        <button type="reset" class="btn btn-ghost-green">Clear filters</button>
      </form>
    </div>
  </div>
  <script is:inline id="job-index" type="application/json" set:html={JSON.stringify({ jobs: index, cats: catNames })} />
  <script>
    type J = { s: string; t: string; e: string; c: string; ci: string; ty: string; ca: string; p: string; f: number; x: string };
    const { jobs, cats } = JSON.parse(document.getElementById("job-index")!.textContent!) as { jobs: J[]; cats: Record<string, string> };
    const form = document.getElementById("filters") as HTMLFormElement;
    const results = document.getElementById("results")!;
    const count = document.getElementById("count")!;
    const more = document.getElementById("more") as HTMLButtonElement;
    const PAGE = 40;
    let shown = PAGE;
    let matches: J[] = jobs;

    const esc = (s: string) => s.replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch]!);
    const ICON = { b: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V8l8-5 8 5v13M9 21v-5h6v5M8 11h.01M12 11h.01M16 11h.01"/></svg>', c: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg>', w: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18"/></svg>' };
    const slug = (c: string) => c.toLowerCase().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    const card = (j: J) => `
      <article class="job${j.f ? " featured" : ""}"><div style="min-width:0">
        <h3 class="title"><a href="/jobs/${j.s}">${esc(j.t)}</a></h3>
        <div class="meta"><span class="item">${ICON.b}${esc(j.e)}</span><span class="item">${ICON.c}${esc(j.p)}</span><span class="item">${ICON.w}${esc(j.ty)}</span></div>
        <div class="tags"><span class="tag">${esc(cats[j.ca] ?? "Other")}</span>${j.f ? '<span class="tag green">Featured</span>' : ""}</div>
      </div><div class="side"><a class="county" href="/counties/${slug(j.c)}">${esc(j.c)} County</a><a class="btn btn-ghost-green" href="/jobs/${j.s}">View Job</a></div></article>`;

    function render() {
      results.innerHTML = matches.length
        ? matches.slice(0, shown).map(card).join("")
        : '<div class="panel empty">No jobs match those filters. Try a nearby county or clear the keyword.</div>';
      count.textContent = `${matches.length.toLocaleString()} open ${matches.length === 1 ? "job" : "jobs"}`;
      more.hidden = matches.length <= shown;
    }

    function apply(pushUrl = true) {
      const d = new FormData(form);
      const q = String(d.get("q") || "").trim().toLowerCase();
      const county = String(d.get("county") || "");
      const category = String(d.get("category") || "");
      const type = String(d.get("type") || "");
      const terms = q.split(/\s+/).filter(Boolean);
      matches = jobs.filter((j) =>
        (!county || j.c === county) && (!category || j.ca === category) && (!type || j.ty === type) &&
        terms.every((t) => `${j.t} ${j.e} ${j.ci} ${j.x}`.toLowerCase().includes(t)));
      shown = PAGE;
      render();
      if (pushUrl) {
        const params = new URLSearchParams();
        for (const [k, v] of d.entries()) if (String(v)) params.set(k, String(v));
        history.replaceState(null, "", params.size ? `?${params}` : location.pathname);
      }
    }

    // Restore filters from the URL so searches are shareable (and the home page search works).
    const params = new URLSearchParams(location.search);
    for (const name of ["q", "county", "category", "type"]) {
      const el = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
      if (el && params.get(name)) el.value = params.get(name)!;
    }
    if (params.size) apply(false); else more.hidden = jobs.length <= PAGE;

    let timer: number | undefined;
    form.addEventListener("input", () => { clearTimeout(timer); timer = window.setTimeout(() => apply(), 120); });
    form.addEventListener("submit", (e) => { e.preventDefault(); apply(); });
    form.addEventListener("reset", () => setTimeout(() => apply(), 0));
    more.addEventListener("click", () => { shown += PAGE; render(); });
  </script>
</Base>
