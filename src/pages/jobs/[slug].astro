---
import Base from "../../layouts/Base.astro";
import JobCard from "../../components/JobCard.astro";
import Icon from "../../components/Icon.astro";
import { SITE } from "../../config/site.ts";
import { categoryName } from "../../config/taxonomy.ts";
import { jobs, formatDate, countySlug, type Job } from "../../lib/jobs.ts";

export function getStaticPaths() {
  return jobs.map((job) => ({ params: { slug: job.slug }, props: { job } }));
}
const { job } = Astro.props as { job: Job };
const related = jobs.filter((j) => j.id !== job.id && j.county === job.county && j.category === job.category).slice(0, 4);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "JobPosting",
  title: job.title,
  description: job.excerpt || job.title,
  datePosted: job.postedAt,
  validThrough: job.deadline ?? undefined,
  employmentType: { "Full Time": "FULL_TIME", "Part Time": "PART_TIME", Substitute: "PER_DIEM", Temporary: "TEMPORARY", Internship: "INTERN" }[job.type],
  hiringOrganization: { "@type": "Organization", name: job.employer },
  jobLocation: { "@type": "Place", address: { "@type": "PostalAddress", addressLocality: job.city || undefined, addressRegion: SITE.stateCode, addressCountry: "US" } },
  url: job.applyUrl,
};
---
<Base title={`${job.title} — ${job.employer}`} description={`${job.title} at ${job.employer} in ${job.county} County, ${SITE.state}. ${job.type}. Apply on the employer's official site.`} jsonLd={jsonLd}>
  <section class="page-hero"><div>
    <a class="back-link" href="/jobs" id="back"><Icon name="back" />Back to results</a>
    <div class="crumbs"><a href="/jobs">Positions</a> › <a href={`/counties/${countySlug(job.county)}`}>{job.county} County</a> › <a href={`/categories/${job.category}`}>{categoryName(job.category)}</a></div>
    <h1 style="font-size:clamp(28px,4vw,44px)">{job.title}</h1>
    <p>{job.employer}</p>
  </div></section>
  <div class="page">
    <div class="wrap detail">
      <div class="panel">
        <div class="facts">
          <div><Icon name="building" /><span>{job.employer}</span></div>
          <div><Icon name="pin" /><span>{job.city ? `${job.city}, ` : ""}{job.county} County, Michigan</span></div>
          <div><Icon name="briefcase" /><span>{job.type} · {categoryName(job.category)}</span></div>
          <div><Icon name="calendar" /><span>Posted <time datetime={job.postedAt} data-rel>{formatDate(job.postedAt)}</time>{job.deadline ? ` · Applications close ${formatDate(job.deadline)}` : ""}</span></div>
        </div>
        <div class="job-actions">
          <button class="btn btn-soft" type="button" data-save={job.slug} aria-pressed="false"><Icon name="heart" /><span data-save-label>Save job</span></button>
          <button class="btn btn-soft" type="button" id="share"><Icon name="share" />Share</button>
        </div>
        <div class="prose" style="margin-top:24px;border-top:1px solid var(--line);padding-top:20px">
          {job.excerpt ? <p>{job.excerpt}</p> : null}
          <p>Full details, requirements and salary are on the employer's official posting.</p>
        </div>
      </div>
      <aside class="panel" style="position:sticky;top:88px">
        <!-- One clear apply action (a lesson from the Ohio hub). -->
        <a class="btn btn-green" style="width:100%" href={job.applyUrl} rel="noopener nofollow" target="_blank">Apply for Job <Icon name="external" class="" /></a>
        <p style="color:var(--muted);font-size:14px;margin:14px 0 0">You'll apply directly with {job.employer} on their official application site. {SITE.name} is always free for job seekers.</p>
      </aside>
    </div>
    {related.length > 0 && (
      <div class="wrap" style="margin-top:56px">
        <h2 style="font-size:24px;font-weight:500;margin:0 0 18px">Similar jobs in {job.county} County</h2>
        <div class="results">{related.map((j) => <JobCard job={j} />)}</div>
      </div>
    )}
  </div>
  <script>
    // "Back to results" returns to the exact search (filters + scroll) when the visitor came from it.
    const back = document.getElementById("back") as HTMLAnchorElement;
    try {
      const ref = document.referrer ? new URL(document.referrer) : null;
      if (ref && ref.origin === location.origin && ref.pathname !== location.pathname) {
        back.href = ref.pathname + ref.search;
        back.addEventListener("click", (e) => { e.preventDefault(); history.back(); });
      }
    } catch {}
    document.getElementById("share")!.addEventListener("click", async () => {
      const data = { title: document.title, url: location.href };
      try {
        if (navigator.share) await navigator.share(data);
        else { await navigator.clipboard.writeText(location.href); (window as any).msjToast?.("Link copied. Paste it anywhere to share."); }
      } catch {}
    });
  </script>
</Base>
