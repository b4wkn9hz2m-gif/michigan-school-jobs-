---
import Base from "../layouts/Base.astro";
---
<Base title="Listing not found" noindex>
  <div class="wrap page">
    <div class="notice" style="max-width:640px">
      <h1 style="font-size:1.5rem">This listing has closed or moved</h1>
      <p>Job postings come down when the employer fills or closes them. The good news: there are new openings every morning.</p>
      <p><a class="btn dark" href="/jobs">Search open jobs</a></p>
    </div>
  </div>
</Base>
