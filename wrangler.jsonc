// Lets Cloudflare's Workers "Import a repository" flow serve the built site.
// (Cloudflare Pages ignores this file; there, set build output directory to `dist`.)
{
  "name": "michigan-school-jobs",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Keep the workers.dev address on until the custom domain is confirmed working.
  "workers_dev": true,
  // Serve the site on the real domain (the zone is in the same Cloudflare account).
  "routes": [
    { "pattern": "michigan-school-jobs.com", "custom_domain": true }
  ]
}
