// Lets Cloudflare's Workers "Import a repository" flow serve the built site.
// (Cloudflare Pages ignores this file; there, set build output directory to `dist`.)
{
  "name": "michigan-school-jobs",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Keep the workers.dev address on until the custom domain is confirmed working.
  "workers_dev": true
  // The custom domain must be attached by the account owner in the Cloudflare dashboard
  // (Workers & Pages -> michigan-school-jobs -> Settings -> Domains & Routes -> Add -> Custom domain):
  // the deploy can't replace the new domain's Cloudflare Registrar placeholder on its own.
}
